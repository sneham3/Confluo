# ---- Mode ----------------------------------------------------------------
# "local"  = no external services: PGlite (embedded Postgres), in-memory KV/pubsub, local disk uploads.
#            Use this to run on a laptop without Docker.
# "cloud"  = PostgreSQL + Redis + S3-compatible storage (docker compose or managed services).
CONFLUO_MODE=local

# ---- URLs ----------------------------------------------------------------
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
SYNC_URL=ws://localhost:4000/sync
PORT=4000

# ---- Auth ----------------------------------------------------------------
# ES256 keys (PEM). Leave empty in local mode and a dev key pair is generated into .data/jwt-*.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
SERVICE_TOKEN=change-me-service-token

# ---- Cloud mode only -------------------------------------------------------
DATABASE_URL=postgres://confluo:confluo@localhost:5432/confluo
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=confluo
S3_ACCESS_KEY=confluo
S3_SECRET_KEY=confluo-secret
S3_FORCE_PATH_STYLE=true

# ---- Sync server -------------------------------------------------------------
SYNC_NODE_ID=node-a
SYNC_MAX_RSS_MB=1024

# ---- Local data dir (local mode) -------------------------------------------
DATA_DIR=.data
